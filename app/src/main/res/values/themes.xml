<resources>

    <style name="Base.Theme.PuzzleGame" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="MyGameButton">
        <item name="android:layout_width">85dp</item>
        <item name="android:layout_height">85dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:background">@drawable/bg_game</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="MyGameButtonResponsive">
        <item name="android:layout_width">85dp</item>
        <item name="android:layout_height">85dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:background">@drawable/bg_game</item>
        <item name="android:layout_margin">1dp</item>
    </style>

</resources>